# Teleconference MCP — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Conferencing MCP ───────────────────────────────────────────────────────
MCP_PORT=10887
MCP_HOST=127.0.0.1
HEALTH_PORT=10891
FASTMCP_LOG_LEVEL=WARNING

# ── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:15580
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-0123456789abcdef-0123456789abcdef

# ── Ollama (Local LLM for meeting intelligence) ────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2

# ── MCP Bridge (multi-server federation) ───────────────────────────────────
# MCP_BRIDGE_URLS=http://localhost:10782/mcp,http://localhost:10756/mcp

# ── Agent Mode: 'local' (Ollama/Whisper/Piper) or 'cloud' (OpenAI/Deepgram/ElevenLabs) ──
AGENT_MODE=local

# ── Cloud Agent (AGENT_MODE=cloud) ─────────────────────────────────────────
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVEN_LABS_API_KEY=

# ── Cloud STT provider: deepgram (default) or muse (EXPERIMENTAL bake-off) ──
# CLOUD_STT_PROVIDER=deepgram
# META_API_KEY=  # Muse Voice Transcribe, $0.18/hr
# MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# MUSE_TRANSCRIBE_BASE_URL=https://api.meta.ai/v1

# ── Auth (Optional — set AUTH_DISABLED=true to skip for dev) ───────────────
# AUTH_DISABLED=true
# AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
# AUTH_AUTHENTIK_ID=
# AUTH_AUTHENTIK_SECRET=
# AUTH_AUTHENTIK_ISSUER=http://localhost:9000/application/o/ag-visio

